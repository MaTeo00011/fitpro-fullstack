{
  "version": 2,
  "builds": [
    {
      "src": "todoapp/package.json",
      "use": "@vercel/static-build",
      "config": {
        "installCommand": "cd todoapp && npm install",
        "buildCommand": "cd todoapp && npm run build",
        "distDir": "todoapp/dist/todoapp/browser"
      }
    },
    {
      "src": "api/[...path].js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}